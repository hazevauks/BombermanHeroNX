# The game is yours to supply: no ROM, and nothing made from one, belongs in the repository.
*.z64
*.n64
*.v64
/RecompiledFuncs/
/RecompiledPatches/
/rsp/
/patches/*.bin
/patches/*.elf
/patches/*.map
/patches/*.o
/patches/*.d

# The SD card layout holds your ROM once packaged, and the logs come from a console: only their READMEs
# belong here.
/SD_CARD/*
!/SD_CARD/README.md
/SD_LOG/*
!/SD_LOG/README.md

# Project notes kept outside the repository
/*Documentation.txt

# The Vulkan driver SDK is downloaded separately (docs/building.md)
/third_party/nvk-sdk/

# Other projects kept next to this one for reference
/_ref/

# Build output
/build/
/out/
*.nro
*.nacp
*.elf
*.map
*.o
*.d
*.exe
*.dll
*.lib
*.pdb

# Symbol dumps
data_dump.toml
dump.toml

# Runtime files of the PC version
imgui.ini
rt64.log
gamecontrollerdb.txt

# Host files
.DS_Store
Thumbs.db
__pycache__/
.vs/
.vscode/
.claude/
